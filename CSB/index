const SCOPE_DATA = {}; // 本版本未使用精英市場/全區切換功能，保留空物件避免JS報錯
// ===== SCOPE TOGGLE =====
function toggleScope(btn,chartId,scope){
  const ch=window[chartId];
  if(!ch||!SCOPE_DATA[chartId])return;
  const d=SCOPE_DATA[chartId][scope];
  ch.data.labels=d.labels;
  ch.data.datasets=d.datasets;
  ch.update();
  const wrap=btn.closest('.scope-toggle');
  if(wrap)wrap.querySelectorAll('.stog').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
}
function toggleScope2(chartId,scope){
  const ch=window[chartId];
  if(!ch||!SCOPE_DATA[chartId])return;
  const d=SCOPE_DATA[chartId][scope];
  ch.data.labels=d.labels;
  ch.data.datasets=d.datasets;
  ch.update();
}

// ===== CHIP NAV FILTER =====
function filterSec(key){
  document.querySelectorAll('.section').forEach(s=>{
    s.style.display=(key==='all'||s.dataset.sec===key)?'':'none';
  });
  document.querySelectorAll('.chip').forEach(c=>{
    c.classList.remove('active');
        const oc=c.getAttribute('onclick')||'';
    if(oc.includes("'"+key+"'"))c.classList.add('active');
  });
}
function jumpSec(key){
  filterSec(key);
  setTimeout(()=>{
    const el=document.querySelector('[data-sec="'+key+'"]');
    if(el)el.scrollIntoView({behavior:'smooth'});
  },50);
}


